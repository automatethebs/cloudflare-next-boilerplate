# =============================================================================
# my-app — copy this file to `.env` and fill in values.
#
#   copy:   copy .env.example .env
#   then:   npm run db:migrate:local
#           npm run dev
#
# For Cloudflare preview/deploy, use the SAME names in `.dev.vars`
# or:  npx wrangler secret put NAME
# Dashboard: https://dash.cloudflare.com
#
# There is no DATABASE_URL. App data lives in Cloudflare D1.
# Only Cloudflare-related keys live here. Push the repo to GitHub.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Site URL
# -----------------------------------------------------------------------------
# The address people use to open this app. No trailing slash.
# Local:  http://localhost:3000
# Live:   https://YOUR-DOMAIN
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. Cron secret (protects /api/cron/*)
# -----------------------------------------------------------------------------
# Scheduled jobs arrive as HTTP calls with `Authorization: Bearer CRON_SECRET`
# from cron-job.org (free, no card) or workers/companion's scheduled relay.
# Random string. Generate:
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#   Or:         openssl rand -hex 32
# Empty = allowed in dev, rejected in production.
CRON_SECRET=


# -----------------------------------------------------------------------------
# 3. Turnstile (optional — bot protection for forms)
# -----------------------------------------------------------------------------
# Free, no card (20 widgets/account).
# Create: https://dash.cloudflare.com → Turnstile → Add widget → copy keys.
# Site key is public: it is inlined at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key stays server-side (also add via `npx wrangler secret put`).
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 4. KV cache (optional — uncomment binding in wrangler.jsonc first)
# -----------------------------------------------------------------------------
# Free, no card: 100k reads/day, 1k writes/day, 1GB. Design write-light.
#   1. npx wrangler kv namespace create CACHE
#   2. Paste the printed `id` into wrangler.jsonc → kv_namespaces[0].id (uncomment)
# No env vars needed. Until then, src/lib/kv.ts uses an in-memory fallback.


# -----------------------------------------------------------------------------
# 5. Database — Cloudflare D1 (not an env var)
# -----------------------------------------------------------------------------
# There is no DATABASE_URL. App data lives in D1.
#
# Create the database (once):
#   npx wrangler login
#   npx wrangler d1 create my-app
# Copy the printed database_id into wrangler.jsonc → d1_databases[0].database_id
#
# Dashboard: https://dash.cloudflare.com → Workers & Pages → D1
#
# Apply tables:
#   npm run db:migrate:local     (for next dev / wrangler local)
#   npm run db:migrate:remote    (for production)
#
# Binding name in wrangler.jsonc: DB
# Database name: my-app
# Local SQLite file: .data/d1.sqlite  (created on first migrate/dev)


# -----------------------------------------------------------------------------
# Production checklist (Cloudflare Workers / OpenNext)
# -----------------------------------------------------------------------------
# 1. npx wrangler login          https://dash.cloudflare.com
# 2. D1 created + database_id in wrangler.jsonc
# 3. npm run db:migrate:remote
# 4. Secrets (same names as above):
#      npx wrangler secret put APP_URL
#      npx wrangler secret put CRON_SECRET
#      npx wrangler secret put TURNSTILE_SECRET_KEY
#    NEXTJS_ENV is already in wrangler.jsonc "vars" (production).
#    NEXT_PUBLIC_TURNSTILE_SITE_KEY must be set at BUILD time
#    (put it in .dev.vars or wrangler.jsonc "vars") because Next inlines it.
# 5. Copy .dev.vars.example → .dev.vars for `npm run preview`
# 6. Push to GitHub, then deploy (or `npm run deploy`)
