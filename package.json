{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/patch-opennext-windows.cjs && npm run db:migrate:local && next dev",
    "build": "next build",
    "postinstall": "node scripts/patch-opennext-windows.cjs",
    "preview": "node scripts/patch-opennext-windows.cjs && npm run db:migrate:local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/patch-opennext-windows.cjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "test": "tsx src/lib/db/d1.test.ts && tsx src/lib/cron.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply my-app --local",
    "db:migrate:remote": "wrangler d1 migrations apply my-app --remote"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Blank Next.js + Cloudflare Workers (OpenNext) + D1/Drizzle template.",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
